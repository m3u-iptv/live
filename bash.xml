ffmpeg -i ../video.mp4 \
  -map 0:v -map 0:a -map 0:v -map 0:a -map 0:v -map 0:a -map 0:v -map 0:a \
  -g 60 -keyint_min 60 -sc_threshold 0 \
  -filter:v:0 scale=-2:1080 -b:v:0 3000k \
  -filter:v:1 scale=-2:720  -b:v:1 1500k \
  -filter:v:2 scale=-2:480  -b:v:2 800k \
  -filter:v:3 scale=-2:360  -b:v:3 400k \
  -c:a aac -b:a 128k \
  -f hls -hls_time 4 -hls_playlist_type vod \
  -master_pl_name playlist.m3u8 \
  -var_stream_map "v:0,a:0 v:1,a:1 v:2,a:2 v:3,a:3" stream_%v.m3u8
