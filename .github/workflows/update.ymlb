name: Update EPG
on:
  schedule:
    - cron: '0 0 * * *'
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install requests
      - run: python merge.py
      - run: |
          git config user.name "EPG Bot"
          git config user.email "bot@bot.com"
          git add epg.xml.gz
          git commit -m "Update EPG" || echo "No Change"
          git push
