import gzip
import os
import urllib.request
import xml.etree.ElementTree as ET

EPG_URL = "https://github.io"

ALLOWED_INTL = [
    "&tv", "&amp;tv", "and tv", "andtv",
    "zee tv", "zee cinema", "sony kal", 
    "colors rishtey", "colors me", "colors apac", 
    "b4u movies", "b4u music"
]

def filter_epg(input_gz_path, output_gz_path):
    valid_channel_ids = set()
    new_root = ET.Element("tv")
    
    with gzip.open(input_gz_path, "rb") as f:
        context = ET.iterparse(f, events=("end",))
        
        for event, elem in context:
            if elem.tag == "channel":
                ch_id = elem.get("id", "").lower()
                disp_name = (elem.findtext("display-name") or "").lower()
                
                is_india = ".in" in ch_id or "jiotv" in ch_id or "tataplay" in ch_id
                is_allowed_hindi = any(name in disp_name or name in ch_id for name in ALLOWED_INTL)
                
                if is_india or is_allowed_hindi:
                    valid_channel_ids.add(elem.get("id"))
                    new_root.append(elem)
                else:
                    elem.clear()
                    
            elif elem.tag == "programme":
                if elem.get("channel") in valid_channel_ids:
                    new_root.append(elem)
                else:
                    elem.clear()

    tree = ET.ElementTree(new_root)
    with gzip.open(output_gz_path, "wb") as out_f:
        tree.write(out_f, encoding="utf-8", xml_declaration=True)

if os.path.exists("epg.xml.gz"):
    filter_epg("epg.xml.gz", "light_epg.xml.gz")
else:
    req = urllib.request.Request(EPG_URL, headers={'User-Agent': 'Mozilla/5.0'})
    with urllib.request.urlopen(req) as response, open("temp_epg.xml.gz", "wb") as out_file:
        out_file.write(response.read())
    filter_epg("temp_epg.xml.gz", "light_epg.xml.gz")
    os.remove("temp_epg.xml.gz")

print("सफल! light_epg.xml.gz तैयार है।")
